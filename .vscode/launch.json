    "version": "0.2.0",
    "configurations": [
        {
            "name": "dex_screener: WIPE",
            "type": "debugpy",
            "request": "launch",
            "module": "dipdup",
            "args": [
                "-C", "compose",
                "-e", "local.env",
                "schema", "wipe", "--force",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "dex_screener: Run XYK",
            "type": "debugpy",
            "request": "launch",
            "module": "dipdup",
            "args": [
                "-C", "compose",
                "-C", "only-xyk",
                "-e", "local.env",
                "run",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "dex_screener: Run LBP",
            "type": "debugpy",
            "request": "launch",
            "module": "dipdup",
            "args": [
                "-C", "compose",
                "-C", "only-lbp",
                "-e", "local.env",
                "run",
            ],
            "cwd": "${workspaceFolder}",
        },
    ]
}